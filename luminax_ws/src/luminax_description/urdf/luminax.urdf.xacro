<?xml version="1.0"?>
<!-- =====================================================================
     LUMINAX / LUMI  -  robot description (navigation base, no arm)
     ROS 2 Jazzy

     TF chain produced by this file (via robot_state_publisher):
         base_footprint -> base_link -> { laser_frame, camera_link, imu_link,
                                          body_link, wheels, caster }
     The odom->base_footprint transform is NOT here; it comes from
     rf2o_laser_odometry.  map->odom comes from slam_toolbox / AMCL.

     >>> EVERY NUMBER MARKED  (MEASURE)  MUST BE REPLACED WITH A REAL
     >>> MEASUREMENT FROM YOUR BUILT ROBOT BEFORE NAVIGATION WILL BE ACCURATE.
     ===================================================================== -->
<robot name="luminax" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       TUNABLE PARAMETERS  -  edit these after measuring the robot
       ============================================================ -->

  <!-- Drive geometry (CRITICAL for odometry & navigation) -->
  <xacro:property name="wheel_radius"     value="0.045"/>  <!-- (MEASURE) wheel radius [m]. 90mm dia wheel -> 0.045 -->
  <xacro:property name="wheel_width"      value="0.035"/>  <!-- (MEASURE) wheel width [m] -->
  <xacro:property name="wheel_separation" value="0.375"/>  <!-- (MEASURE) distance between the two drive-wheel contact points [m] -->
  <xacro:property name="wheel_mass"       value="0.20"/>

  <!-- Chassis base box (the lower deck that carries motors/battery) -->
  <xacro:property name="base_x"   value="0.40"/>   <!-- (MEASURE) length -->
  <xacro:property name="base_y"   value="0.34"/>   <!-- (MEASURE) width  -->
  <xacro:property name="base_z"   value="0.12"/>   <!-- (MEASURE) height of base box -->
  <xacro:property name="base_mass" value="8.0"/>   <!-- (MEASURE) -->

  <!-- Height of the wheel axle above the ground.
       For a wheel of radius r sitting on the floor, the axle is at z = r. -->
  <xacro:property name="axle_height" value="${wheel_radius}"/>

  <!-- LiDAR mounting offset RELATIVE TO base_link origin (CRITICAL).
       base_link origin sits on the ground directly, so these are
       measured from the point on the floor between the drive wheels. -->
  <xacro:property name="lidar_x"   value="0.13"/>  <!-- (MEASURE) forward offset of LiDAR centre [m] -->
  <xacro:property name="lidar_y"   value="0.0"/>   <!-- (MEASURE) left/right offset [m] -->
  <xacro:property name="lidar_z"   value="0.22"/>  <!-- (MEASURE) height of LiDAR scan plane above ground [m] -->
  <xacro:property name="lidar_yaw" value="0.0"/>   <!-- (MEASURE) yaw of the LiDAR 0-angle vs robot +X [rad].
                                                        Many RPLiDAR A1 mounts have the cable/0 pointing BACKWARD;
                                                        if your /scan looks rotated 180 deg, set this to 3.14159. -->

  <!-- Camera mounting offset relative to base_link -->
  <xacro:property name="camera_x" value="0.155"/> <!-- (MEASURE) -->
  <xacro:property name="camera_y" value="0.0"/>   <!-- (MEASURE) -->
  <xacro:property name="camera_z" value="0.85"/>  <!-- (MEASURE) height of camera above ground [m] -->

  <!-- IMU mounting offset relative to base_link (optional sensor) -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.18"/>

  <!-- Caster offset relative to base_link -->
  <xacro:property name="caster_x" value="-0.14"/> <!-- (MEASURE) rear offset -->
  <xacro:property name="caster_radius" value="0.02"/>

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ============================================================
       Materials
       ============================================================ -->
  <material name="body_white"><color rgba="0.92 0.92 0.92 1.0"/></material>
  <material name="dark">      <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="accent">    <color rgba="0.55 0.45 0.85 1.0"/></material>

  <!-- ============================================================
       Reusable inertia macros
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       base_footprint : the ground-projected root frame
       ============================================================ -->
  <link name="base_footprint"/>

  <!-- ============================================================
       base_link : main chassis.  Its origin is on the floor,
       centred between the drive wheels (standard convention).
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${axle_height + base_z/2}" rpy="0 0 0"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${axle_height + base_z/2}" rpy="0 0 0"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       body_link : upper enclosure (visual / collision for nav height)
       ============================================================ -->
  <link name="body_link">
    <visual>
      <origin xyz="0 0 ${axle_height + base_z + 0.22}" rpy="0 0 0"/>
      <geometry><box size="0.34 0.28 0.44"/></geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${axle_height + base_z + 0.22}" rpy="0 0 0"/>
      <geometry><box size="0.34 0.28 0.44"/></geometry>
    </collision>
    <xacro:box_inertia m="4.0" x="0.34" y="0.28" z="0.44"/>
  </link>
  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       Drive wheels
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="prefix side_y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0 ${side_y} ${axle_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  side_y="${ wheel_separation/2}"/>
  <xacro:drive_wheel prefix="right" side_y="${-wheel_separation/2}"/>

  <!-- ============================================================
       Rear caster (passive)
       ============================================================ -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       2D LiDAR  ->  frame name MUST match the driver's frame_id
       and rf2o's laser frame:  laser_frame
       ============================================================ -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="0.045" l="0.04"/>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <!-- ============================================================
       Camera : body frame + REP-103 optical frame
       (optical frame: z forward, x right, y down)
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.08 0.04 0.035"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia m="0.15" x="0.08" y="0.04" z="0.035"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <!-- rotate body frame into optical frame -->
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ============================================================
       IMU frame (optional)
       ============================================================ -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.035 0.035 0.01"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia m="0.03" x="0.035" y="0.035" z="0.01"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

</robot>
