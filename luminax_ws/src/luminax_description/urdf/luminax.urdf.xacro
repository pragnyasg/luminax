<?xml version="1.0"?>
<!-- =====================================================================
     LUMINAX / LUMI  -  Robot Description (Accurate Physical Model)
     ROS 2 Jazzy

     Modeled with exact measurements from physical robot photos using a
     15 cm DOMS engineering scale reference.

     Physical Specifications:
       - Drive Type: 4WD Skid-Steer (4 x Yellow DC TT Gear Motors)
       - Wheels: 65mm dia x 26mm width (Yellow rims + Black treaded tires)
       - Wheel Separation (Track Width): 0.178 m (center-to-center)
       - Wheelbase (Front-to-Rear Axle): 0.145 m
       - Lower Deck: 0.190 m x 0.140 m black acrylic chassis
       - Standoffs: 0.040 m (40 mm) brass hex spacers
       - Upper Deck: 0.180 m x 0.165 m white acrylic mounting deck
       - 2D LiDAR: Slamtec RPLiDAR A1 on elevated black mount
       - LiDAR Optical Scan Plane: z = 0.175 m above floor
       - Head Enclosure: 3D-printed white companion shell with screen bezel
     ===================================================================== -->
<robot name="luminax" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       CALIBRATED PHYSICAL PARAMETERS (from 15cm DOMS Scale Reference)
       ============================================================ -->

  <!-- Drive Geometry -->
  <xacro:property name="wheel_radius"     value="0.0325"/>  <!-- 65 mm diameter TT wheel -> r = 32.5 mm -->
  <xacro:property name="wheel_width"      value="0.026"/>   <!-- 26 mm wheel tread width -->
  <xacro:property name="wheel_separation" value="0.178"/>   <!-- 178 mm track width (150 mm inner distance + 26 mm tire) -->
  <xacro:property name="wheelbase"        value="0.145"/>   <!-- 145 mm front-to-rear axle distance -->
  <xacro:property name="wheel_mass"       value="0.045"/>   <!-- ~45 g per wheel -->

  <!-- Lower Chassis (Black Acrylic Base + Motor Brackets) -->
  <xacro:property name="lower_deck_x"     value="0.190"/>   <!-- 190 mm length -->
  <xacro:property name="lower_deck_y"     value="0.140"/>   <!-- 140 mm width -->
  <xacro:property name="lower_deck_z"     value="0.003"/>   <!-- 3 mm acrylic plate -->
  <xacro:property name="lower_deck_z_pos" value="0.0765"/>  <!-- Lower plate center sits 76.5 mm above ground -->
  <xacro:property name="lower_deck_mass"  value="0.95"/>    <!-- Lower chassis, battery pack, motor drivers ~ 0.95 kg -->

  <!-- Brass Standoffs -->
  <xacro:property name="standoff_h"       value="0.040"/>   <!-- Exactly 40 mm brass standoffs (verified Page 2) -->
  <xacro:property name="standoff_r"       value="0.003"/>   <!-- 6 mm diameter -->

  <!-- Upper Chassis (White Acrylic Deck) -->
  <xacro:property name="upper_deck_x"     value="0.180"/>   <!-- 180 mm length -->
  <xacro:property name="upper_deck_y"     value="0.165"/>   <!-- 165 mm width (verified Page 3) -->
  <xacro:property name="upper_deck_z"     value="0.005"/>   <!-- 5 mm acrylic plate -->
  <xacro:property name="upper_deck_z_pos" value="0.1205"/>  <!-- Upper plate center sits 120.5 mm above ground -->
  <xacro:property name="upper_deck_mass"  value="0.35"/>    <!-- Upper deck plate + hardware ~ 0.35 kg -->

  <!-- LiDAR Sensor (Slamtec RPLiDAR A1) -->
  <xacro:property name="lidar_riser_x"    value="0.120"/>   <!-- Black riser plate length -->
  <xacro:property name="lidar_riser_y"    value="0.095"/>   <!-- Black riser plate width -->
  <xacro:property name="lidar_riser_z"    value="0.003"/>
  <xacro:property name="lidar_x"          value="0.045"/>   <!-- Mounted forward on upper deck (+45 mm) -->
  <xacro:property name="lidar_y"          value="0.000"/>   <!-- Centered laterally -->
  <xacro:property name="lidar_z"          value="0.175"/>   <!-- Exact optical scan plane height = 175 mm above ground (Page 4) -->
  <xacro:property name="lidar_yaw"        value="0.0"/>     <!-- Default forward heading (set 3.14159 if cable orientation requires) -->
  <xacro:property name="lidar_mass"       value="0.17"/>    <!-- 170 g RPLiDAR A1 -->

  <!-- 3D Printed Head / Body Shell -->
  <xacro:property name="head_x"           value="-0.035"/>  <!-- Mounted rearward to clear LiDAR beam -->
  <xacro:property name="head_z"           value="0.235"/>   <!-- Center height of body shell -->
  <xacro:property name="head_length"      value="0.110"/>
  <xacro:property name="head_width"       value="0.160"/>
  <xacro:property name="head_height"      value="0.220"/>
  <xacro:property name="head_mass"        value="0.45"/>    <!-- Shell + Raspberry Pi 5 + display ~ 0.45 kg -->

  <!-- Camera Offset (inside head screen bezel) -->
  <xacro:property name="camera_x"         value="0.025"/>
  <xacro:property name="camera_y"         value="0.000"/>
  <xacro:property name="camera_z"         value="0.305"/>   <!-- 305 mm above ground -->

  <!-- IMU Offset (on lower deck) -->
  <xacro:property name="imu_x"            value="0.000"/>
  <xacro:property name="imu_y"            value="0.000"/>
  <xacro:property name="imu_z"            value="0.082"/>

  <!-- Wheel Axle Height above ground -->
  <xacro:property name="axle_height"      value="${wheel_radius}"/>
  <xacro:property name="PI"               value="3.14159265359"/>

  <!-- ============================================================
       COLOR MATERIALS
       ============================================================ -->
  <material name="chassis_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="deck_white">   <color rgba="0.96 0.96 0.96 1.0"/></material>
  <material name="shell_white">  <color rgba="0.93 0.93 0.94 1.0"/></material>
  <material name="rim_yellow">   <color rgba="0.98 0.80 0.08 1.0"/></material>
  <material name="motor_yellow"> <color rgba="0.95 0.74 0.05 1.0"/></material>
  <material name="rubber_black"> <color rgba="0.12 0.12 0.12 1.0"/></material>
  <material name="brass_gold">   <color rgba="0.82 0.68 0.28 1.0"/></material>
  <material name="sensor_black"> <color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="screen_dark">  <color rgba="0.10 0.14 0.20 1.0"/></material>
  <material name="accent_blue">  <color rgba="0.15 0.50 0.85 1.0"/></material>

  <!-- ============================================================
       REUSABLE INERTIA MACROS
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       1. ROOT FRAMES
       ============================================================ -->
  <!-- base_footprint : Ground projection at z = 0 -->
  <link name="base_footprint"/>

  <!-- base_link : Main reference frame on the ground plane at robot footprint center -->
  <link name="base_link">
    <!-- Visual: Lower Chassis Black Plate -->
    <visual>
      <origin xyz="0 0 ${lower_deck_z_pos}" rpy="0 0 0"/>
      <geometry><box size="${lower_deck_x} ${lower_deck_y} ${lower_deck_z}"/></geometry>
      <material name="chassis_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${lower_deck_z_pos}" rpy="0 0 0"/>
      <geometry><box size="${lower_deck_x} ${lower_deck_y} ${lower_deck_z}"/></geometry>
    </collision>

    <!-- Visual: Left Bracket Leg -->
    <visual>
      <origin xyz="0 0.060 ${(lower_deck_z_pos + axle_height)/2}" rpy="0 0 0"/>
      <geometry><box size="0.160 0.012 ${lower_deck_z_pos - axle_height + 0.01}"/></geometry>
      <material name="chassis_black"/>
    </visual>
    <!-- Visual: Right Bracket Leg -->
    <visual>
      <origin xyz="0 -0.060 ${(lower_deck_z_pos + axle_height)/2}" rpy="0 0 0"/>
      <geometry><box size="0.160 0.012 ${lower_deck_z_pos - axle_height + 0.01}"/></geometry>
      <material name="chassis_black"/>
    </visual>

    <!-- Visual: 4 Yellow TT Gear Motor Bodies -->
    <visual>
      <origin xyz="${wheelbase/2} 0.062 ${axle_height}" rpy="0 0 0"/>
      <geometry><box size="0.065 0.022 0.020"/></geometry>
      <material name="motor_yellow"/>
    </visual>
    <visual>
      <origin xyz="${wheelbase/2} -0.062 ${axle_height}" rpy="0 0 0"/>
      <geometry><box size="0.065 0.022 0.020"/></geometry>
      <material name="motor_yellow"/>
    </visual>
    <visual>
      <origin xyz="${-wheelbase/2} 0.062 ${axle_height}" rpy="0 0 0"/>
      <geometry><box size="0.065 0.022 0.020"/></geometry>
      <material name="motor_yellow"/>
    </visual>
    <visual>
      <origin xyz="${-wheelbase/2} -0.062 ${axle_height}" rpy="0 0 0"/>
      <geometry><box size="0.065 0.022 0.020"/></geometry>
      <material name="motor_yellow"/>
    </visual>

    <!-- Visual: 4 Brass Standoff Pillars -->
    <visual>
      <origin xyz="0.075 0.060 ${lower_deck_z_pos + standoff_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${standoff_r}" length="${standoff_h}"/></geometry>
      <material name="brass_gold"/>
    </visual>
    <visual>
      <origin xyz="0.075 -0.060 ${lower_deck_z_pos + standoff_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${standoff_r}" length="${standoff_h}"/></geometry>
      <material name="brass_gold"/>
    </visual>
    <visual>
      <origin xyz="-0.075 0.060 ${lower_deck_z_pos + standoff_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${standoff_r}" length="${standoff_h}"/></geometry>
      <material name="brass_gold"/>
    </visual>
    <visual>
      <origin xyz="-0.075 -0.060 ${lower_deck_z_pos + standoff_h/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${standoff_r}" length="${standoff_h}"/></geometry>
      <material name="brass_gold"/>
    </visual>

    <!-- Visual: Upper Chassis White Deck Plate -->
    <visual>
      <origin xyz="0 0 ${upper_deck_z_pos}" rpy="0 0 0"/>
      <geometry><box size="${upper_deck_x} ${upper_deck_y} ${upper_deck_z}"/></geometry>
      <material name="deck_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_deck_z_pos}" rpy="0 0 0"/>
      <geometry><box size="${upper_deck_x} ${upper_deck_y} ${upper_deck_z}"/></geometry>
    </collision>

    <!-- Visual: Battery Gauge Display on Side -->
    <visual>
      <origin xyz="0.020 0.072 ${lower_deck_z_pos + 0.005}" rpy="0 0 0"/>
      <geometry><box size="0.045 0.010 0.020"/></geometry>
      <material name="accent_blue"/>
    </visual>

    <xacro:box_inertia m="${lower_deck_mass + upper_deck_mass}" x="${lower_deck_x}" y="${lower_deck_y}" z="${upper_deck_z_pos}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       2. 4WD DRIVE WHEELS (Skid-Steer / 4-Wheel Drive)
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="prefix pos_x side_y">
    <link name="${prefix}_wheel_link">
      <!-- Rubber Tire Tread (Black) -->
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber_black"/>
      </visual>
      <!-- Yellow Rim Center -->
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius * 0.78}" length="${wheel_width + 0.001}"/></geometry>
        <material name="rim_yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${pos_x} ${side_y} ${axle_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- 4 Independent Drive Wheels (Skid-Steer) -->
  <xacro:drive_wheel prefix="front_left"  pos_x="${ wheelbase/2}" side_y="${ wheel_separation/2}"/>
  <xacro:drive_wheel prefix="front_right" pos_x="${ wheelbase/2}" side_y="${-wheel_separation/2}"/>
  <xacro:drive_wheel prefix="rear_left"   pos_x="${-wheelbase/2}" side_y="${ wheel_separation/2}"/>
  <xacro:drive_wheel prefix="rear_right"  pos_x="${-wheelbase/2}" side_y="${-wheel_separation/2}"/>

  <!-- Passive Caster Wheel Link (Virtual / Backwards Compatibility) -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel_link"/>
    <origin xyz="-0.080 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       3. 2D LIDAR (Slamtec RPLiDAR A1)
          TF frame: laser_frame (must match sllidar_node & rf2o)
       ============================================================ -->
  <link name="laser_frame">
    <!-- Elevated Black Riser Mount Plate -->
    <visual>
      <origin xyz="0 0 -0.040" rpy="0 0 0"/>
      <geometry><box size="${lidar_riser_x} ${lidar_riser_y} ${lidar_riser_z}"/></geometry>
      <material name="chassis_black"/>
    </visual>
    <!-- RPLiDAR A1 Rotating Turret -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.040"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <!-- Secondary Belt Drive Motor on Side -->
    <visual>
      <origin xyz="-0.032 0 -0.010" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.025"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.045"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="0.038" l="0.045"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <!-- Optional lidar_link alias for packages expecting lidar_link frame -->
  <link name="lidar_link"/>
  <joint name="lidar_link_alias_joint" type="fixed">
    <parent link="laser_frame"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       4. UPPER COMPANION BODY / HEAD SHELL (3D Printed Enclosure)
       ============================================================ -->
  <link name="body_link">
    <!-- Main Upper Body Shell (White) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${head_length} ${head_width} ${head_height}"/></geometry>
      <material name="shell_white"/>
    </visual>
    <!-- Recessed Screen Bezel / Face Display Opening -->
    <visual>
      <origin xyz="${head_length/2 + 0.002} 0 0.045" rpy="0 0 0"/>
      <geometry><box size="0.004 0.130 0.085"/></geometry>
      <material name="screen_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${head_length} ${head_width} ${head_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${head_mass}" x="${head_length}" y="${head_width}" z="${head_height}"/>
  </link>

  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="body_link"/>
    <origin xyz="${head_x} 0 ${head_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       5. CAMERA SENSOR (REP-103 Optical Frame)
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.060 0.025"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia m="0.05" x="0.025" y="0.060" z="0.025"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <!-- Rotate body frame to optical frame: z forward, x right, y down -->
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- Alias camera_optical_link for nodes expecting camera_optical_link -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_link_alias" type="fixed">
    <parent link="camera_optical_frame"/>
    <child  link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       6. IMU SENSOR FRAME
       ============================================================ -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.025 0.025 0.008"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertia m="0.02" x="0.025" y="0.025" z="0.008"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

</robot>
