<?xml version="1.0"?>
<robot name="healthcare_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================== -->
  <!--                      BAYMAX HEALTHCARE ROBOT URDF                    -->
  <!-- ==================================================================== -->
  <!-- Educational Notes for Student Oral Defense:                           -->
  <!-- LINK: Represents a rigid physical part of the robot (chassis, wheel). -->
  <!-- JOINT: Defines physical connection and degrees of freedom between    -->
  <!--        parent and child links (fixed, continuous, revolute).          -->
  <!-- INERTIA: Calculated rotational inertia components required by physics-->
  <!--          engines (Gazebo) to simulate mass distribution accurately.   -->
  <!-- GAZEBO PLUGINS: Simulates differential drive motor physics, 2D LiDAR  -->
  <!--                 laser scans, and camera video streams in ROS 2.      -->
  <!-- ==================================================================== -->

  <!-- ==================== PARAMETERS & DIMENSIONS ==================== -->
  <!-- Robot Chassis Dimensions (Soft rounded capsule design) -->
  <xacro:property name="chassis_radius" value="0.18" />   <!-- 36cm diameter body -->
  <xacro:property name="chassis_height" value="0.40" />   <!-- 40cm body height -->
  <xacro:property name="chassis_mass"   value="5.00" />   <!-- 5.0 kg total mass -->

  <!-- Wheel Dimensions (Differential Drive) -->
  <xacro:property name="wheel_radius"   value="0.04" />   <!-- 8cm diameter wheel -->
  <xacro:property name="wheel_width"    value="0.02" />   <!-- 2cm wheel thickness -->
  <xacro:property name="wheel_track"    value="0.32" />   <!-- Distance between wheel centers -->
  <xacro:property name="wheel_mass"     value="0.25" />   <!-- 250 grams per wheel -->

  <!-- Caster Wheel (Rear Support) -->
  <xacro:property name="caster_radius"  value="0.02" />   <!-- 4cm diameter sphere -->
  <xacro:property name="caster_mass"    value="0.10" />   <!-- 100 grams -->
  <xacro:property name="caster_x_offset" value="-0.12" /> <!-- Positioned rear of chassis -->

  <!-- LiDAR Sensor -->
  <xacro:property name="lidar_radius"   value="0.035" />  <!-- 7cm diameter RPLiDAR -->
  <xacro:property name="lidar_height"   value="0.04" />   <!-- 4cm height -->
  <xacro:property name="lidar_mass"     value="0.15" />   <!-- 150 grams -->

  <!-- Camera Sensor -->
  <xacro:property name="camera_length"  value="0.02" />
  <xacro:property name="camera_width"   value="0.06" />
  <xacro:property name="camera_height"  value="0.03" />
  <xacro:property name="camera_mass"    value="0.05" />

  <!-- ==================== MATERIALS & COLORS ==================== -->
  <material name="baymax_white">
    <color rgba="0.92 0.94 0.96 1.0"/>
  </material>

  <material name="baymax_accent">
    <color rgba="0.20 0.65 0.85 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <material name="sensor_blue">
    <color rgba="0.10 0.30 0.70 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- ==================== INERTIAL CALCULATORS ==================== -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*m*(3*r*r + h*h)}" iyz="0.0"
               izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5)*m*r*r}" ixy="0.0" ixz="0.0"
               iyy="${(2/5)*m*r*r}" iyz="0.0"
               izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*m*(x*x + z*z)}" iyz="0.0"
               izz="${(1/12)*m*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== LINKS & JOINTS ==================== -->

  <!-- 1. BASE FOOTPRINT LINK (Ground Level Projection at Z = 0) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 2. BASE LINK (Main Robot Chassis Body) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
      <material name="baymax_white"/>
    </visual>

    <visual>
      <origin xyz="0 0 ${chassis_height * 0.7}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius + 0.002}" length="0.02"/>
      </geometry>
      <material name="baymax_accent"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia m="${chassis_mass}" r="${chassis_radius}" h="${chassis_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- 3. WHEEL MACRO (Left and Right Differential Drive Wheels) -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_track / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_reflect="1" />
  <xacro:wheel prefix="right" y_reflect="-1" />

  <!-- 4. CASTER WHEEL (Rear Passive Balancing Ball) -->
  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${caster_x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Low surface friction for caster wheel so it slides smoothly in Gazebo -->
  <gazebo reference="caster_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- 5. LIDAR SENSOR LINK -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 ${chassis_height + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- 6. CAMERA SENSOR LINK -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${camera_mass}" x="${camera_length}" y="${camera_width}" z="${camera_height}"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_radius + camera_length/2} 0 ${chassis_height * 0.75}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Camera Optical Frame -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>


  <!-- ==================== GAZEBO ROS PLUGINS ==================== -->

  <!-- 1. DIFFERENTIAL DRIVE MOTOR PLUGIN -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>

      <!-- Wheel Joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematics -->
      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <!-- Limits & Torque -->
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <!-- Frame & Telemetry Output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 2. 2D LIDAR RAY SENSOR PLUGIN -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 3. RGB CAMERA SENSOR PLUGIN -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/image_raw</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
