<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_voice</name>
  <version>0.2.0</version>
  <description>Deep learning voice assistant, Whisper STT, local LLM, and TTS speech synthesis for LUMINAX Robot</description>

  <maintainer email="dev@luminax-robotics.org">LUMINAX Healthcare Companion Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
